# =============================================================================
# .env.example — template env var cho podman-compose
# =============================================================================
# Cách dùng:
#   1) cp .env.example .env
#   2) Sinh JWT_SECRET thật:
#        echo "JWT_SECRET=$(openssl rand -base64 48)" >> .env
#   3) podman-compose up -d
#
# CẢNH BÁO: .env có secret thật → đã add vào .gitignore, KHÔNG commit.
# File .env.example này (không có secret thật) thì có thể commit.
# =============================================================================

# JWT signing secret — Base64-encoded ≥256-bit.
# Sinh bằng: openssl rand -base64 48
JWT_SECRET=REPLACE_ME_RUN_openssl_rand_base64_48
