<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.personal</groupId>
    <artifactId>identity-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Identity Platform Parent</name>
    <description>Multi-module identity service</description>
    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lombok.version>1.18.46</lombok.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <spring-boot.version>4.0.6</spring-boot.version>
    </properties>
    <!--
                FIX: previously only listed `auth-context/auth-domain` and the *-context
                parents. Each sub-module (api/application/domain/infrastructure) is
                already declared in its own *-context/pom.xml, so listing the *-context
                parents here is enough — Maven will recurse. We removed the stray
                `auth-context/auth-domain` entry.
              -->
    <modules>
        <module>platform-shared</module>
        <module>platform-shared-jpa</module>
        <module>platform-contracts</module>
        <module>auth-context</module>
        <module>permission-context</module>
        <module>token-context</module>
        <module>session-context</module>
        <module>identity-bootstrap</module>
    </modules>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <!--   Platform modules   -->
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>platform-shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>platform-shared-jpa</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>platform-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!--   Auth context   -->
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>auth-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>auth-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>auth-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>auth-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!--   Permission context   -->
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>permission-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>permission-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>permission-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>permission-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!--   Token context   -->
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>token-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>token-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>token-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>token-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!--   Session context   -->
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>session-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>session-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>session-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>session-api</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <source>21</source>
                        <target>21</target>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>